{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "cef-wayland-smoke",
  "version": "0.1.0",
  "identifier": "dev.okhsunrog.cef-wayland-smoke",
  "build": {
    "beforeDevCommand": "vp run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "vp run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "CEF \u00b7 Wayland \u00b7 Vulkan",
        "width": 1100,
        "height": 900
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
