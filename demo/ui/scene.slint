import { Slider, GroupBox, HorizontalBox, VerticalBox, GridBox, Button, ComboBox, Palette } from "std-widgets.slint";
import { PlotWidget } from "@slint-realtime-plot/plot.slint";

export component App inherits Window {
    in property <image> texture <=> plot.texture;
    // Physical pixels so the texture stays crisp on hidpi screens.
    out property <int> requested-texture-width: plot.requested-texture-width / 1phx;
    out property <int> requested-texture-height: plot.requested-texture-height / 1phx;

    out property <float> amplitude <=> amp-slider.value;
    out property <float> frequency <=> freq-slider.value;
    in-out property <float> time-window <=> plot.time-window;
    in-out property <bool> paused <=> plot.paused;
    out property <int> view-offset <=> plot.view-offset;
    // Luminance-based: color-scheme reads `unknown` when following the system.
    out property <bool> dark-mode: Palette.background.to-hsv().value < 0.5;

    // Auto-ranged Y axis, fed back from PlotRenderer::render() each frame.
    in property <float> y-min <=> plot.y-min;
    in property <float> y-max <=> plot.y-max;
    in property <int> y-divisions <=> plot.y-divisions;

    // Cursor measurement: position out, formatted values back in.
    out property <bool> cursor-active: plot.cursor-active;
    out property <float> cursor-frac: plot.cursor-frac;
    in property <string> cursor-text <=> plot.cursor-text;

    in property <string> status-text: "Initializing...";
    in property <string> export-status: "";

    callback export-csv();
    callback export-png();

    preferred-width: 900px;
    preferred-height: 650px;
    title: "3-Phase Motor Current - Real-Time Plot";

    VerticalBox {
        x: root.safe-area-insets.left;
        y: root.safe-area-insets.top;
        width: root.width - root.safe-area-insets.right - root.safe-area-insets.left;
        height: root.height - root.safe-area-insets.bottom - root.safe-area-insets.top;

        plot := PlotWidget {
            vertical-stretch: 1;
            min-width: 320px;
            min-height: 200px;
            title: "3-Phase Motor Current Waveform";
            x-divisions: 5;
            time-window: 1.0;
            // 32768 samples @ 20 kHz
            max-time-window: 1.6;
            sample-rate: 20000.0;
            legend-labels: ["Phase A", "Phase B", "Phase C"];
            legend-colors: [#22d3ee, #8b5cf6, #f97316];
        }

        HorizontalBox {
            Text {
                text: root.status-text;
                vertical-alignment: center;
            }
            Text {
                text: root.export-status;
                vertical-alignment: center;
                opacity: 0.8;
            }
            Text {
                text: "scroll/pinch: zoom | double-click: pause | drag (paused): pan";
                vertical-alignment: center;
                horizontal-alignment: right;
                opacity: 0.6;
            }
        }

        GroupBox {
            title: "Controls";
            GridBox {
                Row {
                    Text { text: "Amplitude (A):"; vertical-alignment: center; }
                    amp-slider := Slider { minimum: 0.1; maximum: 10.0; value: 5.0; }
                }
                Row {
                    Text { text: "Frequency (Hz):"; vertical-alignment: center; }
                    freq-slider := Slider { minimum: 1.0; maximum: 20.0; value: 5.0; }
                }
                Row {
                    Text { text: "Time Window (s):"; vertical-alignment: center; }
                    tw-slider := Slider {
                        minimum: 0.1;
                        maximum: 1.6;
                        value <=> root.time-window;
                    }
                }
                Row {
                    Text { text: "Theme:"; vertical-alignment: center; }
                    theme-combo := ComboBox {
                        model: ["System", "Dark", "Light"];
                        current-index: 0;
                        selected => {
                            if (self.current-index == 0) {
                                Palette.color-scheme = ColorScheme.unknown;
                            } else if (self.current-index == 1) {
                                Palette.color-scheme = ColorScheme.dark;
                            } else {
                                Palette.color-scheme = ColorScheme.light;
                            }
                        }
                    }
                }
                Row {
                    Button {
                        text: root.paused ? "Resume" : "Pause";
                        clicked => {
                            root.paused = !root.paused;
                            if (!root.paused) {
                                plot.view-offset = 0;
                            }
                        }
                    }
                    HorizontalBox {
                        padding: 0;
                        Button {
                            text: "Export CSV";
                            clicked => { root.export-csv(); }
                        }
                        Button {
                            text: "Export PNG";
                            clicked => { root.export-png(); }
                        }
                    }
                }
            }
        }
    }
}
